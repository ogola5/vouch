# Copy this file to `.env` and fill in the real values.
#
#     cp .env.example .env
#
# `.env` is gitignored and must stay that way — it holds live credentials.
# This file is committed and must therefore never contain a real key.
#
# Nothing loads these automatically. Node 24 reads them with a flag, which the
# dev scripts already pass:
#
#     node --env-file-if-exists=.env ...
#
# (`--env-file-if-exists` rather than `--env-file` so the services still start
# on a fresh checkout that has no .env yet — only the orchestrator needs one.)

# ---------------------------------------------------------------------------
# Model provider for the orchestrator (packages/orchestrator)
# ---------------------------------------------------------------------------

# Google Gemini. Get a key at https://aistudio.google.com/apikey
# This is the name Strands' GoogleModel looks for; do not rename it.
GEMINI_API_KEY=

# Which Gemini model the orchestrator uses. Flash is the sensible default for
# a demo: it is fast and cheap, and the orchestrator's job is turning a
# sentence into tool calls, not deep reasoning. The actual authority decision
# is never the model's — it is made by the gate in packages/mcp-server.
GEMINI_MODEL_ID=gemini-2.5-flash

# ---------------------------------------------------------------------------
# Service endpoints — only set these if you have moved something off its
# default port. The dev scripts already agree on these values.
# ---------------------------------------------------------------------------

# MERCHANT_PORT=4010
# MCP_PORT=4020
# WEB_PORT=4030
# MCP_URL=http://127.0.0.1:4020/mcp
# MERCHANT_URL=http://127.0.0.1:4010

# Where the SQLite database lives, relative to where the server is started.
# VOUCH_DB=vouch.db

# ---------------------------------------------------------------------------
# Not needed yet — recorded so the swap is obvious when it happens
# ---------------------------------------------------------------------------

# When the $150 AWS credit lands, the orchestrator's model provider becomes
# Bedrock (a constructor argument, not a rewrite) and BedrockReasoningProvider
# replaces RuleBasedReasoningProvider at the composition root.
# AWS_REGION=us-west-2
# AWS_PROFILE=

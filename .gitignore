node_modules/
dist/
build/
*.tsbuildinfo
.next/
*.log
.env
.env.local
*.db
*.sqlite
*.sqlite3
# SQLite in WAL mode (packages/db sets journal_mode=WAL) writes two sidecar
# files next to the database. They are runtime state, not source, and appear
# the moment `npm run dev:mcp-server` is started.
*.db-wal
*.db-shm

# Captured Ring webhook deliveries. Never committed: they carry real device
# ids, a real HMAC signature and whatever else Ring puts on the wire for this
# account. The capture file is evidence for writing types against, not source.
webhook-capture.jsonl
*.jsonl
*.sqlite-wal
*.sqlite-shm
.DS_Store
coverage/

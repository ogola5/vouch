{
  "name": "vouch",
  "private": true,
  "type": "module",
  "version": "0.0.0",
  "description": "The trust layer for what your AI agent actually did — not just what it says it will do.",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "tsc -b",
    "dev:mcp-server": "npm run dev --workspace packages/mcp-server",
    "dev:mock-merchant": "npm run dev --workspace packages/mock-merchant",
    "dev:web-app": "npm run dev --workspace packages/web-app",
    "dev:all": "npm run dev:mock-merchant & npm run dev:mcp-server & npm run dev:web-app",
    "check:model": "node --env-file-if-exists=.env packages/orchestrator/src/checkModel.ts",
    "typecheck": "tsc -b && tsc -p tsconfig.test.json",
    "test": "tsc -b && node --enable-source-maps --test \"test/**/*.test.ts\" \"packages/*/test/**/*.test.ts\""
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "typescript": "^5.5.4"
  },
  "engines": {
    "node": ">=24"
  }
}
